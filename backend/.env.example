SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Get a free key at https://aistudio.google.com/apikey — no card required.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072

# Postgres connection string. Locally you can point this at a local Postgres,
# or a free Supabase project's "Session pooler" URI for the deployed version.
# Any URL-unsafe characters in the password (@ ? % etc.) must be percent-encoded.
DATABASE_URL=postgresql://user:password@localhost:5432/edubot

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,txt,docx,png,jpg,jpeg

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

APP_ENV=development
LOG_LEVEL=INFO
